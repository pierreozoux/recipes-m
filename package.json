{
  "name": "recipes-m",
  "version": "0.1.3",
  "description": "Desktop app to manage recipes",
  "main": "./out/main/index.cjs",
  "author": "pierre@ozoux.net",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pierreozoux/recipes-m.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "electron-rebuild -w better-sqlite3",
    "dev": "electron-rebuild -w better-sqlite3 && electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "pretest": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "posttest": "electron-rebuild -w better-sqlite3",
    "test:watch": "vitest",
    "pretest:e2e": "electron-rebuild -w better-sqlite3",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@blocknote/core": "^0.22.0",
    "@blocknote/mantine": "^0.22.0",
    "@blocknote/react": "^0.22.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@mantine/spotlight": "^7.17.0",
    "@tabler/icons-react": "^3.30.0",
    "@tanstack/react-query": "^4.36.1",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.3",
    "@trpc/client": "^10.45.2",
    "@trpc/react-query": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.39.3",
    "electron-trpc": "^0.7.1",
    "frimousse": "^0.1.1",
    "i18next": "^24.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "3.6.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "commit-and-tag-version": "^13.0.0",
    "drizzle-kit": "^0.30.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.0.4"
  }
}
